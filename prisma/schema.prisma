generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ORG_USER
  ADMIN
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum RequestStatus {
  OPEN
  MATCHED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WAITING_LIST
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  role                  UserRole
  displayName           String    @map("display_name")
  firstName             String?   @map("first_name")
  lastName              String?   @map("last_name")
  phone                 String?
  preferredLanguage     String    @default("de") @map("preferred_language")
  emailVerified         Boolean   @default(false) @map("email_verified")
  emailVerifyToken      String?   @map("email_verify_token")
  emailVerifyTokenExpires DateTime? @map("email_verify_token_expires")
  passwordResetToken    String?   @map("password_reset_token")
  passwordResetTokenExpires DateTime? @map("password_reset_token_expires")
  phoneVerified         Boolean   @default(false) @map("phone_verified")
  lastLoginAt           DateTime? @map("last_login_at")
  adminNotes            String?   @map("admin_notes")
  newsletterOptIn       Boolean   @default(false) @map("newsletter_opt_in")
  blockedAt             DateTime? @map("blocked_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  memberships       OrganizationMember[]
  createdOrgs       Organization[]       @relation("CreatedBy")
  volunteerTrips    VolunteerTrip[]
  applications      RequestApplication[]
  sentMessages      Message[]            @relation("MessageSender")
  conversations     Conversation[]       @relation("ConversationUser")
  profile          UserProfile?
  reviewsGiven     Review[]              @relation("Reviewer")
  reviewsReceived  Review[]              @relation("Reviewee")

  @@index([blockedAt])
}

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  avatarUrl        String?  @map("avatar_url")
  city             String?
  countryCode      String?  @map("country_code")
  aboutMe          String?  @map("about_me")
  languages        String[] @default([])
  preferredRoutes  String[] @default([]) @map("preferred_routes")
  frequentAirports String[] @default([]) @map("frequent_airports")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  landingContent  String?   @map("landing_content")
  website         String?
  preferredLanguage String  @default("de") @map("preferred_language")
  contactEmail    String    @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  contactInstagram String?  @map("contact_instagram")
  contactFacebook  String?  @map("contact_facebook")
  status          OrgStatus @default(PENDING)
  logoUrl         String?   @map("logo_url")
  automatedMessageTemplate1 String? @map("automated_message_template_1")
  automatedMessageTemplate2 String? @map("automated_message_template_2")
  automatedMessageTemplate3 String? @map("automated_message_template_3")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdByUser User                 @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members       OrganizationMember[]
  locations     OrgLocation[]
  animals       Animal[]
  requests      TransportRequest[]
  requestGroups TransportRequestGroup[]
  conversations Conversation[]       @relation("ConversationOrg")
  reviews       Review[]
  adminCrmNotes AdminOrganizationNote[]
  adminCrmTasks AdminOrganizationTask[]
}

model OrganizationMember {
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  memberRole     MemberRole @map("member_role")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

model OrgLocation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  title          String
  countryCode    String   @map("country_code")
  city           String
  address        String?
  postalCode     String?  @map("postal_code")
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Animal {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  species        String
  sex            String?
  sizeClass      String?  @map("size_class")
  birthdate      DateTime?
  notes          String?
  imageUrl       String?  @map("image_url")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transportRequests TransportRequest[]
}

model TransportRequest {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  animalId       String?       @map("animal_id")
  groupId        String?       @map("group_id")
  title          String
  details        String?
  status         RequestStatus @default(OPEN)
  waitingListEnabled Boolean   @default(false) @map("waiting_list_enabled")
  animalCanFlyInCargo Boolean  @default(false) @map("animal_can_fly_in_cargo")
  animalCanFlyInCabin Boolean  @default(false) @map("animal_can_fly_in_cabin")
  earliestDate   DateTime      @map("earliest_date")
  latestDate     DateTime      @map("latest_date")
  originAirport  String        @map("origin_airport")
  destAirport    String        @map("dest_airport")
  originLat      Float?        @map("origin_lat")
  originLng      Float?        @map("origin_lng")
  destLat        Float?        @map("dest_lat")
  destLng        Float?        @map("dest_lng")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  animal       Animal?              @relation(fields: [animalId], references: [id], onDelete: SetNull)
  group        TransportRequestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  destinations TransportRequestDestination[]
  applications RequestApplication[]
  conversations Conversation[]      @relation("ConversationRequest")
  reviews      Review[]

  @@index([groupId])
}

model TransportRequestDestination {
  id         String   @id @default(cuid())
  requestId  String   @map("request_id")
  airportCode String  @map("airport_code")
  lat        Float?
  lng        Float?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model TransportRequestGroup {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  title          String
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests      TransportRequest[]

  @@index([organizationId])
}

model VolunteerTrip {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  departDate    DateTime  @map("depart_date")
  returnDate    DateTime? @map("return_date")
  originAirport String?   @map("origin_airport")
  destAirport   String?   @map("dest_airport")
  originLat     Float?    @map("origin_lat")
  originLng     Float?    @map("origin_lng")
  destLat       Float?    @map("dest_lat")
  destLng       Float?    @map("dest_lng")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RequestApplication {
  id             String            @id @default(cuid())
  requestId      String            @map("request_id")
  userId         String            @map("user_id")
  groupId        String?           @map("group_id")
  status         ApplicationStatus @default(PENDING)
  message        String?
  applicationData Json?            @map("application_data")
  attachmentPath  String?           @map("attachment_path")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
  @@index([groupId])
}

model Conversation {
  id             String    @id @default(cuid())
  requestId      String?   @map("request_id")
  organizationId String?   @map("organization_id")
  userId         String?   @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  request      TransportRequest? @relation("ConversationRequest", fields: [requestId], references: [id], onDelete: Cascade)
  organization Organization?     @relation("ConversationOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation("ConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  senderUserId   String    @map("sender_user_id")
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
}

model Review {
  id              String    @id @default(cuid())
  requestId       String    @map("request_id")
  reviewerUserId  String    @map("reviewer_user_id")
  revieweeUserId  String?   @map("reviewee_user_id")
  revieweeOrgId   String?   @map("reviewee_org_id")
  rating          Int
  comment         String?
  orgResponse     String?   @map("org_response")
  orgResponseAt   DateTime? @map("org_response_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  request      TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer     User             @relation("Reviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  revieweeUser User?            @relation("Reviewee", fields: [revieweeUserId], references: [id], onDelete: Cascade)
  revieweeOrg  Organization?    @relation(fields: [revieweeOrgId], references: [id], onDelete: Cascade)
  reports      ReviewReport[]

  @@unique([requestId, reviewerUserId, revieweeUserId, revieweeOrgId])
  @@index([requestId])
  @@index([revieweeUserId])
  @@index([revieweeOrgId])
}

model ReviewReport {
  id           String   @id @default(cuid())
  reviewId     String   @map("review_id")
  reporterUserId String @map("reporter_user_id")
  reason       String?  @map("reason")
  createdAt    DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// Acquise: Flugpaten-Organisationen / Plattformen zur Kontaktaufnahme
enum MediationType {
  ANIMALS       // Tiere
  HUMANITARIAN  // Humanitär
  MEDICAL       // Medizin
  MIXED         // Gemischt
}

enum MediatesGermany {
  YES
  NO
  UNKNOWN
}

enum AcquisitionStatus {
  OPEN        // Offen
  CONTACTED   // Kontaktiert
  REPLIED     // Hat geantwortet
  REGISTERED  // Registriert / Partner
  REJECTED    // Abgelehnt / Kein Interesse
}

enum MailStatus {
  SENT        // Versendet (API erfolgreich)
  DELIVERED   // Zugestellt (vom Mailserver bestätigt)
  BOUNCED     // Bounce (permanent zurückgewiesen)
  FAILED      // Fehlgeschlagen (API-Fehler)
  COMPLAINED  // Als Spam markiert
}

model AcquisitionContact {
  id                  String             @id @default(cuid())
  name                String
  country             String
  continent           String
  websiteLanguage     String             @map("website_language")
  websiteUrl          String?            @map("website_url")
  email               String?
  contactFormUrl      String?            @map("contact_form_url")
  mediationType       MediationType      @map("mediation_type")
  mediatesToGermany   MediatesGermany    @map("mediates_to_germany")
  mediatesFromGermany MediatesGermany    @map("mediates_from_germany")
  notes               String?
  noted               Boolean            @default(false)  // manuell notiert/erfasst
  emailSent           Boolean            @default(false)  @map("email_sent")  // Email gesendet
  status              AcquisitionStatus  @default(OPEN)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  mailLogs            AcquisitionMailLog[]
}

model AcquisitionMailLog {
  id                  String      @id @default(cuid())
  acquisitionContactId String     @map("acquisition_contact_id")
  resendId            String      @map("resend_id")  // Resend message ID
  status              MailStatus   @default(SENT)
  sentAt              DateTime    @default(now()) @map("sent_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  contact             AcquisitionContact @relation(fields: [acquisitionContactId], references: [id], onDelete: Cascade)

  @@index([acquisitionContactId])
  @@index([resendId])
}

// Einstellungen für Acquise-E-Mails (eine Zeile, id = 'default')
model AcquisitionMailSettings {
  id         String   @id @default("default")
  subject    String?  @map("subject")  // E-Mail-Betreff – im Frontend bearbeitbar
  body       String?  @map("body")  // E-Mail-Text – im Frontend bearbeitbar
  footerText String?  @map("footer_text")  // Footer-Text (Name, E-Mail, Telefon) – im Frontend bearbeitbar
  footerHtml String?  @map("footer_html") @db.Text // Optionaler globaler HTML-Footer
  footerTextDe String? @map("footer_text_de")
  footerTextEn String? @map("footer_text_en")
  footerHtmlDe String? @map("footer_html_de") @db.Text
  footerHtmlEn String? @map("footer_html_en") @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")
}

// Globale Site-Einstellungen (z. B. Wartungsmodus)
model SiteSetting {
  key   String @id
  value String
}

// Orga Aquise: Instagram Outreach / Organisationen-Kontakte
model OrgaAquise {
  id                     String    @id @default(cuid())
  name                   String
  instagramHandle        String?   @map("instagram_handle")
  kontaktStatus          String    @default("nicht kontaktiert") @map("kontakt_status")
  letzteKontaktaufnahme  DateTime? @map("letzte_kontaktaufnahme")
  naechsteKontaktaufnahme DateTime? @map("naechste_kontaktaufnahme")
  notizen                String?
  createdAt              DateTime  @default(now()) @map("created_at")

  tasks OrgaAquiseTask[]
}

// Tasks für Follow-Ups (automatisch generiert)
model OrgaAquiseTask {
  id          String    @id @default(cuid())
  orgaId      String    @map("orga_id")
  titel       String
  beschreibung String?
  dueDate     DateTime  @map("due_date")
  status      String    @default("offen")
  createdAt   DateTime  @default(now()) @map("created_at")

  orga OrgaAquise @relation(fields: [orgaId], references: [id], onDelete: Cascade)

  @@unique([orgaId, dueDate])
  @@index([orgaId])
  @@index([status])
}

// —— Admin: konfigurierbare E-Mail-Trigger + Archiv ——

enum EmailDeliveryMode {
  IMMEDIATE // sofort versenden
  QUEUED    // nur in Warteschlange; Versand im Admin
}

enum EmailRecipientKind {
  ORG_CONTACT_EMAIL // Kontakt-E-Mail der Organisation
  USER_SELF         // betroffener Nutzer (userId / Kontext)
  ADMIN_EMAIL       // ADMIN_NOTIFY_EMAIL aus Runtime-Config
}

enum OutboundEmailStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model EmailNotificationRule {
  triggerKey      String            @id @map("trigger_key")
  labelDe         String            @map("label_de")
  descriptionDe   String?           @map("description_de")
  enabled         Boolean           @default(true)
  deliveryMode    EmailDeliveryMode @default(IMMEDIATE) @map("delivery_mode")
  recipientKind   EmailRecipientKind @map("recipient_kind")
  subjectTemplate String            @map("subject_template") @db.Text
  bodyTemplate    String            @map("body_template") @db.Text
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("email_notification_rules")
}

model OutboundEmail {
  id                String              @id @default(cuid())
  triggerKey        String              @map("trigger_key")
  status            OutboundEmailStatus @default(QUEUED)
  toEmail           String              @map("to_email")
  subject           String
  bodyHtml          String              @map("body_html") @db.Text
  bodyPlain         String?             @map("body_plain") @db.Text
  metadata          Json?
  organizationId    String?             @map("organization_id")
  requestId         String?             @map("request_id")
  userId            String?             @map("user_id")
  providerMessageId String?             @map("provider_message_id")
  deliveryStatus    MailStatus?         @map("delivery_status")
  errorMessage      String?             @map("error_message") @db.Text
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([triggerKey, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("outbound_emails")
}

model AdminOrganizationNote {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  content          String   @db.Text
  createdByAdminId String?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("admin_organization_notes")
}

model AdminOrganizationTask {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  title            String
  description      String?  @db.Text
  dueDate          DateTime? @map("due_date")
  status           String   @default("offen")
  createdByAdminId String?  @map("created_by_admin_id")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueDate])
  @@map("admin_organization_tasks")
}
