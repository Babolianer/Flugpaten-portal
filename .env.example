# Supabase: Project Settings → Database → Connection string
# Direct: postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
JWT_SECRET="dev-secret-change-in-production"
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Hostinger SMTP (E-Mail-Versand: Verifizierung, Passwort vergessen, Acquise)
# hPanel → Emails → Manage → Connect Apps & Devices
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@pawtransfer.net
SMTP_PASS=dein-postfach-passwort

# Falls SSL/465 nicht funktioniert: Port 587, SMTP_SECURE=false
# SMTP_PORT=587
# SMTP_SECURE=false

# Absender (sollte SMTP_USER entsprechen)
MAIL_FROM="PawTransfer <noreply@pawtransfer.net>"
# NUXT_PUBLIC_APP_URL für E-Mails (Plattform-Link): in Produktion eure echte URL setzen.
# Optional: Logo-URL für E-Mails
# MAIL_LOGO_URL="https://pawtransfer.net/logo.png"

# Optional: Empfänger für Admin-Trigger (z. B. neue Organisations-Registrierung)
# ADMIN_NOTIFY_EMAIL="admin@example.org"

# Supabase Storage (Profilbilder, Tierbilder): Supabase Dashboard → Settings → API
# URL: https://<PROJECT_REF>.supabase.co
# Service Role Key: Unter "Project API keys" (NICHT den anon key verwenden!)
# SQL für Avatare: prisma/scripts/supabase-storage-avatars.sql im Supabase SQL Editor ausführen
# SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
