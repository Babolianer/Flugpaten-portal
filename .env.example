# Supabase: Project Settings → Database → Connection string
# Direct: postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
# Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
JWT_SECRET="dev-secret-change-in-production"
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (E-Mail-Versand Admin/Acquise): https://resend.com
RESEND_API_KEY="re_xxxx"
# Webhook Secret (aus Resend Dashboard → Webhooks → Signing Secret kopieren)
RESEND_WEBHOOK_SECRET="whsec_xxxx"
# Absender – für Massenversand bitte eigene Domain bei Resend hinterlegen:
# Resend Dashboard → Domains → Domain hinzufügen (z. B. deinedomain.de), DNS-Einträge setzen.
# Danach hier eintragen (kein localhost, kein onboarding@resend.dev für Produktion):
# MAIL_FROM="PawBridge <noreply@deinedomain.de>"
# NUXT_PUBLIC_APP_URL für E-Mails (Plattform-Link): in Produktion eure echte URL setzen.
# Optional: Logo-URL für E-Mails
# MAIL_LOGO_URL="https://deinedomain.de/logo.png"

# Supabase Storage (Profilbilder, Tierbilder): Supabase Dashboard → Settings → API
# URL: https://<PROJECT_REF>.supabase.co
# Service Role Key: Unter "Project API keys" (NICHT den anon key verwenden!)
# SQL für Avatare: prisma/scripts/supabase-storage-avatars.sql im Supabase SQL Editor ausführen
# SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
